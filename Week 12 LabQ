import java.io.*;
import java.sql.*;
import java.util.*;
// Main execution class
public class SequentialDataPipeline {
    public static void main(String[] args) {
        SharedData sharedData = new SharedData();

        ConnectionClass t1 = new ConnectionClass(sharedData);
        Process t2 = new Process(sharedData);
        WriteToFile t3 = new WriteToFile(sharedData, "commissions.csv");

        try {
            // Start Thread 1 and wait for it to finish
            t1.start();
            t1.join(); 

            // Start Thread 2 ONLY after Thread 1 is entirely done
            t2.start();
            t2.join();

            // Start Thread 3 ONLY after Thread 2 is entirely done
            t3.start();
            t3.join();

            System.out.println("Main thread: Entire pipeline finished successfully.");

        } catch (InterruptedException e) {
            e.printStackTrace();
        }
    }
}
class SharedData {
    //raw data from db
    public List<String[]> rawData = new ArrayList<>();
    //processed data ready for csv
    public List<String> processedData = new ArrayList<>();
}

//Thread 1: Connect to DB and retrieve data
class ConnectionClass extends Thread {
    final SharedData data;

    public ConnectionClass(SharedData data) {
        this.data = data;
    }
    
@Override
    public void run() {
        System.out.println("Thread 1 (ConnectionClass): Connecting to database and retrieving data...");
        String url = "jdbc:mariadb://localhost:3306/labwork"; 
        String user = "bethany"; 
        String password = "spring26ppc";

        // Querying salesPersons and their totalCommission
        String query = 
        "SELECT name, commission * TotalAmount AS TotalCommission FROM salesmanview GROUP BY name";

        try(Connection conn = DriverManager.getConnection(url, user, password);
            Statement stmt = conn.createStatement();
            ResultSet rs = stmt.executeQuery(query)){

            while (rs.next()) {
                String name = rs.getString("name");
                String commission = rs.getString("totalCommission");
                data.rawData.add(new String[]{name, commission});
            }
            System.out.println("Thread 1: Data retrieval complete.");

        } catch (SQLException e) {
            e.printStackTrace();
        }
    }
}

// Thread 2: Process the retrieved data
class Process extends Thread {
    final SharedData data;

    public Process(SharedData data) {
        this.data = data;
    }

    @Override
    public void run() {
        System.out.println("Thread 2 (Process): Formatting data for CSV...");
        
        // Add a header row
        data.processedData.add("SalesPerson,TotalCommission");

        // Format raw array data into CSV strings
        for (String[] row : data.rawData) {
            String formattedRow = row[0] + "," + row[1];
            data.processedData.add(formattedRow);
        }
        
        System.out.println("Thread 2: Data processing complete.");
    }
}

// Thread 3: Write processed data to a CSV file
class WriteToFile extends Thread {
    private SharedData data;
    private String filename;

    public WriteToFile(SharedData data, String filename) {
        this.data = data;
        this.filename = filename;
    }

    @Override
    public void run() {
        System.out.println("Thread 3 (WriteToFile): Writing data to " + filename + "...");
        
        try (PrintWriter writer = new PrintWriter(new FileWriter(filename))) {
            for (String line : data.processedData) {
                writer.println(line);
            }
            System.out.println("Thread 3: File writing complete.");
        } catch (IOException e) {
            e.printStackTrace();
        }
    }
}
