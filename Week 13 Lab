import java.sql.*;
import java.util.*;
import java.util.function.*;
import java.util.stream.*;
//use a jdbc connection to the db to retrieve the id, name and salary information to create Employee objects using the Employee class below, after populate the list  
public class Week13 {
        public static void main(String[] args) {
        if (args.length < 3) {
            System.out.println("Usage: java RetrieveData <db_url> <username> <password>");
            return;
        }
        //get database connection parameters from command line arguments
        String dbUrl = args[0];
        String user = args[1];
        String pass = args[2];
        
        List<Employee> employees = new ArrayList<>();

        Function <ResultSet, Employee> employeeMapper = rs -> {
            try{
                return new Employee(
                rs.getInt("id"),
                rs.getString("name"),
                rs.getDouble("salary")
                );
            } catch (SQLException e) {
                throw new RuntimeException("Error mapping ResultSet to Employee", e);
            }
        };

        try (Connection conn = DriverManager.getConnection(dbUrl, user, pass)) {
            Statement stmt = conn.createStatement();
            ResultSet rs = stmt.executeQuery("SELECT id, name, salary FROM Employees");
            while (rs.next()) {
                Employee emp = employeeMapper.apply(rs);
                employees.add(emp);
         }
        } catch (SQLException e) {
            e.printStackTrace();
    }
  // 2. Print the list of employees
  System.out.println("List of Employees:");
        employees.forEach(System.out::println);

//3. Define a Predicate to filter employees with salary greater than 50000        
Predicate<Employee> highEarnersPred = emp -> emp.getSalary() > 50000;
List<Employee> highEarningEmployees = employees.stream()
        .filter(highEarnersPred)
        .collect(Collectors.toList());
//4. Print a list of high earning employees
System.out.println("\nEmployees with salary greater than 50000:");
highEarningEmployees.forEach(System.out::println);
//5. Define a Function<Employee, Employee> names applyTax to apply a 15% tax reduction to highearners.
// The function should take an Employee and return an Employee with adjusted salary.

Function<Employee, Employee> applyTax = emp -> new Employee(
    emp.getId(),
    emp.getName(),
    emp.getSalary() * 0.85 // Apply 15% tax reduction
);
//6. Create a Function <Employee, String> named formatSalary to format the salary to 2 decimal places, with $ attached in the front
Function<Employee, String> formatSalary = emp -> String.format("$%.2f", emp.getSalary());

//7. Now using a stream on the employeeList, filter, apply ax, and createa a list of the type List<Employee> of highEarners with the new salaries.
System.out.println("\nHigh earning employees with adjusted salaries:");
List<Employee> adjustedHighEarners = employees.stream()
        .filter(highEarnersPred)
        .map(applyTax)
        .collect(Collectors.toList());

        adjustedHighEarners.forEach(System.out::println);

//8. EXTRA: Can you think of a single sequence of stream functions to take the list of employees, apply a 10% tax to those earning less than or equal to $50,000, 15% to those earning above $50,000, and neatly format the Employee string to show their names and salaries ? (Explore partitionBy or groupBy collectors)
System.out.println("\nAll employees with adjusted salaries and formatted output:");
List<String> formattedSalaries = employees.stream()
        .map(emp -> {
            double adjustedSalary = emp.getSalary() > 50000 ? emp.getSalary() * 0.85 : emp.getSalary() * 0.90;
            return String.format("%s: %s", emp.getName(), formatSalary.apply(new Employee(emp.getId(), emp.getName(), adjustedSalary)));
        })
        .collect(Collectors.toList());

// Print the formatted salaries
    formattedSalaries.forEach(System.out::println);
    }
public static class Employee{

    private int id;
    private String name;
    private double salary;

public Employee(int id,String name,double salary){
    this.id=id;
    this.name=name;
    this.salary=salary;
    }
@Override
public String toString(){
   return String.format("Employee{id=%d, name='%s', salary=%.2f}", id, name, salary);
    }
    
public int getId(){
    return id;
}
public String getName(){
    return name;
}
public double getSalary(){
    return salary;
}
}}
