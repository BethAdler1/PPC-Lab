/* 
1.
(a) Write a program that implements the Runnable interface to calculate the sum of numbers from 1 to
100. The main thread should wait for this calculation to finish before printing the result. Note that the
summation should be done in a thread, created with the Runnable interface, and the main() just displays
the result.
*/
class ImplementsRunnable implements Runnable {
    private int sum;

    @Override
    public void run() {
        sum = 0;
        for (int i = 1; i <= 100; i++) {
            sum += i;
        }
    }

    public int getSum() {
        return sum;
    }
}
/*
(b) Create a class that extends the Thread interface to calculate the sum of numbers from 1 to 100. The
main thread should wait for this calculation to finish before printing the result */
class ExtendsThread extends Thread {
    private int sum;

    @Override
    public void run() {
        sum = 0;
        for (int i = 1; i <= 100; i++) {
            sum += i;
        }
    }

    public int getSum() {
        return sum;
    }
}
public class Problem1{
    public static void main(String[] args) {

        ImplementsRunnable runnable = new ImplementsRunnable();
        Thread t1 = new Thread(runnable);
        t1.start();
        ExtendsThread t2 = new ExtendsThread();
        t2.start();

        try {
            t1.join(); // Wait for the thread to finish
            t2.join(); // Wait for the thread to finish
        } catch (InterruptedException e) {
            e.printStackTrace();
        }

        System.out.println("The sum of numbers from 1 to 100 is: " + runnable.getSum());
        System.out.println("The sum of numbers from 1 to 100 is: " + t2.getSum());
    }
}
