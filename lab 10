public class Customer {
    private String name;
    private String city;
    private Double total_spent;

    public Customer(String name, String city, Double total_spent) {
        this.name = name;
        this.city = city;
        this.total_spent = total_spent;
    }
    public Double getTotalSpent() {
        return total_spent;
    }
    public String getName() {
        return name;
    }
    public String getCity() {
        return city;
    }
    public void setName(String name) {
        this.name = name;
    }
    public void setCity(String city) {
        this.city = city;
    }
    public void setTotalSpent(Double total_spent) {
        this.total_spent = total_spent;
    }
    @Override
    public String toString(){
        return "Customer{name='" + name + "', city='" + city + "', total_spent=" + total_spent + "}";
    }
}

public class SalesPerson {
    private String name;
    private String city;
    private Double totalSales;

    public SalesPerson(String name, String city, Double total_sales) {
        this.name = name;
        this.city = city;
        this.totalSales = total_sales;
    }
    @Override
    public String toString(){
        return "SalesPerson{name='" + name + "', city='" + city + "', totalSales=" + totalSales + "}";
    }
    public String getName() {
        return name;
    }
    public String getCity() {
        return city;
    }
    public Double getTotalSales() {
        return totalSales;
    }
    public void setName(String name) {
        this.name = name;
    }
    public void setCity(String city) {
        this.city = city;
    }
    public void setTotalSales(Double total_sales) {
        this.totalSales = total_sales;
    }

}

public class RetrieveData {
    public static void main(String[] args) {
        if (args.length < 3) {
            System.out.println("Usage: java RetrieveData <db_url> <username> <password>");
            return;
        }
        //get database connection parameters from command line arguments
        String dbUrl = args[0];
        String user = args[1];
        String pass = args[2];

        List<Customer> customerList = new ArrayList<>();
        List<SalesPerson> salesPersonList = new ArrayList<>();
 
        Function <ResultSet, Customer> customerMapper = rs -> {
            try{
                return new Customer(
                rs.getString("Name"), 
                rs.getString("City"), 
                rs.getDouble("TotalAmount"));
            } catch (SQLException e) {
                throw new RuntimeException("Error mapping ResultSet to Customer", e);
            }
        };

        Function <ResultSet, SalesPerson> salesPersonMapper = rs -> {
            try{
                return new SalesPerson(
                rs.getString("Name"), 
                rs.getString("City"), 
                rs.getDouble("TotalAmount"));
            } catch (SQLException e) {
                throw new RuntimeException("Error mapping ResultSet to SalesPerson", e);
            }
        };

           
        //connect to the Maria DB and retrieve data from the views, mapping them to Customer and SalesPerson objects
        try (Connection conn = DriverManager.getConnection(dbUrl, user, pass)){

            Statement stmtC = conn.createStatement();
            ResultSet rsC = stmtC.executeQuery("SELECT* FROM CustomerView");
                while (rsC.next()) {
                    customerList.add(customerMapper.apply(rsC));
                }

            Statement stmtSP = conn.createStatement();
            ResultSet rsSP = stmtSP.executeQuery("SELECT* FROM SalesmanView");
                while (rsSP.next()) {
                    salesPersonList.add(salesPersonMapper.apply(rsSP));
                }
            } catch (SQLException e) {
                e.printStackTrace();
                }
        //-----Stream operations
         //print 10 customers and 10 Salespeople
        System.out.println("First 10 Customers:");
        customerList.stream().limit(10).forEach(System.out::println);
            
        System.out.println("\nFirst 10 SalesPeople:");
        salesPersonList.stream().limit(10).forEach(System.out::println);
            
        //Use Collectors.averagingDouble() to get the average a Customer spent
        double avgSpent = customerList.stream()
        .collect(Collectors.averagingDouble(Customer::getTotalSpent));
        System.out.println("\nAverage amount spent by Customers: " + avgSpent);

        //Create a list of high spenders, those who spent more than the avg, ordered in decreasing amounts spent. Print the top 10 high spenders.
         List<Customer> highSpenders = customerList.stream()
         .filter(c -> c.getTotalSpent() > avgSpent)
         .sorted(Comparator.comparingDouble(Customer::getTotalSpent)
         .reversed())
         .limit(10)
         .collect(Collectors.toList());

         System.out.println("\nTop 10 High Spenders:");
        highSpenders.forEach(System.out::println);

        //What city has the top 5 spenders?
        List<String> top5Cities = highSpenders.stream()
        .limit(5)
        .map(Customer::getCity)
        .distinct()
        .collect(Collectors.toList());

        System.out.println("\nCities with Top 5 Spenders:");
        top5Cities.forEach(System.out::println);
            }
        }
